import { NextRequest, NextResponse } from "next/server";

export const config = {
  matcher: [
    /*
     * Match all paths except for:
     * 1. /api routes
     * 2. /_next (static files)
     * 3. /_static (public assets)
     * 4. /_vercel (vercel telemetry)
     * 5. Static files (e.g. favicon.ico, sitemap.xml, robots.txt, etc.)
     */
    "/((?!api/|_next/|_static/|_vercel|[\\w-]+\\.\\w+).*)",
  ],
};

export default async function middleware(req: NextRequest) {
  const url = req.nextUrl;

  // Ambil hostname (misal: toko.localhost:3000 atau toko.stockysee.com)
  const hostname = req.headers.get("host") || "localhost:3000";

  // Tentukan domain utama aplikasi (ubah ini saat sudah beli domain)
  const rootDomain = process.env.NODE_ENV === "production" 
    ? "stockysee.vercel.app" 
    : "localhost:3000";

  // Ekstrak subdomain
  // Jika hostname adalah toko.localhost:3000, maka subdomain adalah 'toko'
  const searchParams = url.searchParams.toString();
  const path = `${url.pathname}${searchParams.length > 0 ? `?${searchParams}` : ""}`;

  // PENGECUALIAN: Jangan di-rewrite jika mengakses halaman inti aplikasi
  const isInternalPage = 
    path.startsWith("/register") || 
    path.startsWith("/super-gate") || 
    path.startsWith("/admin-panel") ||
    path.startsWith("/dashboard");

  // Logika Multi-tenant
  if (hostname.endsWith(`.${rootDomain}`) && !isInternalPage) {
    const subdomain = hostname.replace(`.${rootDomain}`, "");
    
    // Rewrite secara internal ke folder storefront
    console.log(`[Middleware] Rewriting ${hostname}${path} to /storefront/${subdomain}${path}`);
    return NextResponse.rewrite(new URL(`/storefront/${subdomain}${path}`, req.url));
  }

  // Jika bukan subdomain, biarkan request berlanjut (misal halaman utama stockysee.com)
  return NextResponse.next();
}
